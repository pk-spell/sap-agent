# Frontend Dockerfile - SAP Deployment Assistant V3
FROM node:24-alpine

WORKDIR /app

# Copy package files
COPY frontend-react/package*.json ./

# Install dependencies
RUN npm install

# Copy frontend code
COPY frontend-react/ .

# Expose port
EXPOSE 5173

# Start frontend (host 0.0.0.0 for Docker)
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
